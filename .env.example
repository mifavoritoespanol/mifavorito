# Schedule: Bebidas 15-30 Nov 2026, Comidas 15-31 Dec 2026, Música 15-31 Jan 2027 (Europe/Madrid).
# Optional overrides use ISO 8601: ELECTION_BEBIDAS_OPENS_AT / CLOSES_AT, etc.
ELECTION_BEBIDAS_OPENS_AT=
ELECTION_BEBIDAS_CLOSES_AT=
ELECTION_COMIDAS_OPENS_AT=
ELECTION_COMIDAS_CLOSES_AT=
ELECTION_ESTRELLAS_OPENS_AT=
ELECTION_ESTRELLAS_CLOSES_AT=
ELECTION_CATEGORY_SLUG=estrellas

# Local-only checkout testing. Both flags must be true and the app must run with `npm run dev`.
# Use Stripe TEST keys and a separate Supabase staging project; never point this mode at production data.
ELECTION_TEST_MODE=false
NEXT_PUBLIC_ELECTION_TEST_MODE=false
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_SUPABASE_TEST_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_TEST_PUBLISHABLE_KEY=your_staging_publishable_key
SUPABASE_TEST_SECRET_KEY=your_staging_secret_key

# Local preview only: unlock these scheduled category pages while running npm run dev.
LOCAL_PREVIEW_CATEGORIES=bebidas,comidas
# Public contact displayed in legal pages and used for Stripe receipts.
CONTACT_EMAIL=contact@mifavorito.app


# Google account allowed to review proposals at /montana.
ADMIN_EMAIL=your-google-email@example.com
