# Election dates (ISO 8601, UTC). Defaults: 15 Dec 2026, 12:00 UTC through 30 Dec 2026, 12:00 UTC.
ELECTION_OPENS_AT=
ELECTION_CLOSES_AT=
ELECTION_CATEGORY_SLUG=estrellas

# Local-only checkout testing. Both flags must be true and the app must run with `npm run dev`.
# Use Stripe TEST keys and a separate Supabase staging project; never point this mode at production data.
ELECTION_TEST_MODE=false
NEXT_PUBLIC_ELECTION_TEST_MODE=false
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_SUPABASE_TEST_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_TEST_PUBLISHABLE_KEY=your_staging_publishable_key
SUPABASE_TEST_SECRET_KEY=your_staging_secret_key
